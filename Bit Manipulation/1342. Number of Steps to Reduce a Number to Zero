class Solution {
    public int numberOfSteps(int num) {
        return countstep(num ,0);
    }
    public int countstep(int num,int c){
        if(num==0){
            return c;
        }
        if(num%2 ==0){
            return countstep(num/2,c+1);
        }
        return countstep(num-1,c+1);
    }
}
