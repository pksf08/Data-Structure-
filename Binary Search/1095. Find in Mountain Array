class Solution {
    public int findInMountainArray(int target, MountainArray mountainArr) {
        int peak = peakIndexInMountainArray(mountainArr);
        int ans = bsearch(mountainArr,target,0,peak,true);
        if(ans!=-1){
            return ans;
        }
        return bsearch(mountainArr,target,peak+1,mountainArr.length()-1,false);
        
    }
    public static int peakIndexInMountainArray(MountainArray arr) {
            int start = 0;
            int end = arr.length()-1;
            while(start<end){
                int mid = start +(end-start)/2;
                int v1 =arr.get(mid),v2=arr.get(mid+1);
                if(v1>v2){
                    end = mid;
                }
                else{
                    start=mid+1;
                }
            }
            return start;
    }
    static int bsearch(MountainArray arr,int target,int start,int end,boolean isasc){
        while(start<=end){
            int mid = start+(end-start)/2;
            int value = arr.get(mid);
            if(isasc){
                 if(value<target){
                start = mid+1;
                }
                else {
                    end = mid-1;
                }
            }
            else{
                if(value<target){ 
                    end = mid-1;
                }
                else {
                    start = mid+1;
                }
            }
            if(value==target){
                return mid;
            }
        }
        return -1;
    }
}
